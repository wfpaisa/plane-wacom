[Unit]
Description=Wacom stylus pan-scroll daemon (Wayland xsetwacom PanScroll replacement)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/projects/plane-wacom/wacom_panscroll.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
